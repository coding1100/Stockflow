# Next.js web app. Single reliable build: install → prisma generate → next build → next start.
# (Debian slim + openssl so the Prisma query engine works out of the box.)
FROM node:22-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN corepack enable
WORKDIR /app

COPY . .
RUN pnpm install --frozen-lockfile=false
RUN pnpm --filter @stockflow/db generate \
 && pnpm --filter @stockflow/web build

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
EXPOSE 3000
# `next start` (our start script binds 0.0.0.0). Reliable; no standalone/engine copy gotchas.
CMD ["pnpm", "--filter", "@stockflow/web", "start"]
