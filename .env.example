# Copy to .env for local dev. infra/.env.demo holds demo defaults.
NODE_ENV=development

# Postgres (Docker Compose: see infra/docker-compose.yml)
DATABASE_URL=postgresql://stockflow:stockflow@localhost:5432/stockflow?schema=public

# Redis (event bus + pub/sub)
REDIS_URL=redis://localhost:6379

# Auth (NextAuth)
NEXTAUTH_SECRET=dev-only-secret-change-me-please-32chars
NEXTAUTH_URL=http://localhost:3000

# Observability (optional — no-op when unset)
SENTRY_DSN=

# Seed scenario: demo-default | peak | clean
SEED_SCENARIO=demo-default
