# Copy to infra/.env.deploy and fill in. Used by docker-compose.full.yml.
# Keep this file OUT of git (already covered by .gitignore for .env*).

# --- Database (internal hostname = the compose service name) ---
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=stockflow
DATABASE_URL=postgresql://stockflow:change-me-strong-password@postgres:5432/stockflow?schema=public

# --- Redis (internal hostname) ---
REDIS_URL=redis://redis:6379

# --- Auth ---
# Generate: openssl rand -base64 48
NEXTAUTH_SECRET=replace-with-a-long-random-secret
# Public HTTPS URL users hit (through your nginx / Caddy):
NEXTAUTH_URL=https://retail-automation.infosoftco.com

# --- Demo order generator: keep OFF in production ---
DEMO_ORDER_DRIP=off

# --- Only used by the optional bundled Caddy (--profile tls) ---
DOMAIN=retail-automation.infosoftco.com
